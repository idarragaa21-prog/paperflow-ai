# ╔══════════════════════════════════════════════════════════╗
# ║          PaperFlow AI — Variables de Entorno             ║
# ║   Copia este archivo a backend/.env y ajusta los valores ║
# ╚══════════════════════════════════════════════════════════╝

# ── Entorno ────────────────────────────────────────────────
# development | production
ENV=development

# ── Base de datos PostgreSQL ───────────────────────────────
# Docker Compose expone postgres en localhost:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paperflow_ai

# ── Seguridad ──────────────────────────────────────────────
# Genera una clave segura: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis (rate limiting + colas RQ) ──────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Almacenamiento local ───────────────────────────────────
# filesystem: guarda archivos en disco local
# s3: usa MinIO (también corre en Docker Compose)
STORAGE_BACKEND=filesystem
STORAGE_BASE_PATH=~/PaperFlowAIData

# ── MinIO (S3-compatible, solo si STORAGE_BACKEND=s3) ─────
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=paperflow
S3_SECRET_KEY=paperflow123
S3_BUCKET=paperflow-artifacts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# ── Resolución de Open Access ──────────────────────────────
# Unpaywall usa tu email para identificar las peticiones (requerido)
UNPAYWALL_EMAIL=tu@email.com

# ── Extractor de metadatos ─────────────────────────────────
META_MAX_CONCURRENT=3
OCR_ENABLED=false

# ── IA Local (Ollama) ──────────────────────────────────────
# Ollama debe estar corriendo localmente o en Docker
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelos Ollama a usar (deben estar descargados: ollama pull <model>)
PAPERFLOW_CHAT_MODEL=qwen2.5:7b
PAPERFLOW_EXTRACTION_MODEL=qwen2.5:7b
PAPERFLOW_WRITING_MODEL=llama3.1:8b
PAPERFLOW_EMBEDDING_MODEL=bge-m3

# ── Proveedor LLM ──────────────────────────────────────────
# openclaw: enrutador multi-proveedor local (recomendado)
# direct_claude: llamadas directas a Anthropic API
LLM_PROVIDER=openclaw
LLM_STRATEGY=single

# ── OpenClaw (enrutador LLM local multi-proveedor) ─────────
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TIMEOUT=120
# Token de autenticación del servidor OpenClaw (opcional)
OPENCLAW_GATEWAY_TOKEN=

# Modelos por proveedor en OpenClaw (usa "default" para el modelo por defecto)
OPENCLAW_MODEL=default
OPENCLAW_CLAUDE_MODEL=default
OPENCLAW_OPENAI_MODEL=default
OPENCLAW_GEMINI_MODEL=default

# ── Anthropic API (directo, opcional) ─────────────────────
# Solo necesario si LLM_PROVIDER=direct_claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20240620
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.3

# ── Qdrant (búsqueda vectorial) ────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_PREFIX=paperflow

# ── Grobid (parser de PDFs científicos) ───────────────────
GROBID_URL=http://127.0.0.1:8070
GROBID_ENABLED=true
GROBID_TIMEOUT_SECONDS=45

# ── Motor R (estadísticas clínicas) ───────────────────────
R_ENGINE_URL=http://127.0.0.1:8010

# ── Configuración del chat con papers ─────────────────────
CHAT_MIN_RETRIEVED_CHUNKS=2
CHAT_MIN_GROUNDED_SCORE=0.35
CHAT_ENABLE_INTERNAL_DEBUG=false
# extractive_strict | hybrid | generative
CHAT_DEFAULT_MODE=extractive_strict

# Modo de runtime por defecto para proyectos nuevos
# local_only | cloud_assisted
PROJECT_DEFAULT_RUNTIME_MODE=local_only

# ── Presentaciones (número de slides generados) ────────────
PRESENTATION_SLIDE_TARGET=36
PRESENTATION_SLIDE_MIN=30
PRESENTATION_SLIDE_MAX=40

# ── CORS (orígenes permitidos) ─────────────────────────────
# En desarrollo: Vite corre en 127.0.0.1:5173
# En producción: BACKEND_CORS_ORIGINS=["https://app.paperflow.ai","https://paperflow.ai"]
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Cookie domain ──────────────────────────────────────────
# Dejar vacío para desarrollo local (None = browser default).
# En producción con subdominios: COOKIE_DOMAIN=.paperflow.ai
COOKIE_DOMAIN=

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── OpenTelemetry (observabilidad, opcional) ───────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=paperflow-backend

# ── Variables del Frontend (frontend/.env) ─────────────────
# Copia las siguientes a un archivo frontend/.env
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_BASE_PATH=/
