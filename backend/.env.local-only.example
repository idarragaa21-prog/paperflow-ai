# Backend profile: local-only (cheap and stable)

ENV=development
SECRET_KEY=CHANGE_ME__generate_a_long_random_secret
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/paperflow_ai
REDIS_URL=redis://127.0.0.1:6379/0

STORAGE_BASE_PATH=~/PaperFlowAIData
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=paperflow
S3_SECRET_KEY=paperflow123
S3_BUCKET=paperflow-artifacts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

UNPAYWALL_EMAIL=you@example.com
META_MAX_CONCURRENT=3
OCR_ENABLED=false

LLM_PROVIDER=openclaw
LLM_STRATEGY=single
PROJECT_DEFAULT_RUNTIME_MODE=local_only
OLLAMA_BASE_URL=http://127.0.0.1:11434
PAPERFLOW_CHAT_MODEL=qwen2.5-coder:7b
PAPERFLOW_EXTRACTION_MODEL=qwen2.5-coder:7b
PAPERFLOW_WRITING_MODEL=qwen2.5-coder:7b
PAPERFLOW_EMBEDDING_MODEL=nomic-embed-text:latest
QDRANT_URL=http://127.0.0.1:6333
R_ENGINE_URL=http://127.0.0.1:8010
GROBID_URL=http://127.0.0.1:8070
GROBID_ENABLED=true
GROBID_TIMEOUT_SECONDS=45

CHAT_MIN_RETRIEVED_CHUNKS=2
CHAT_MIN_GROUNDED_SCORE=0.35
CHAT_ENABLE_INTERNAL_DEBUG=false
CHAT_DEFAULT_MODE=extractive_strict

OTEL_ENABLED=false
OTEL_SERVICE_NAME=paperflow-backend

OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TIMEOUT=120
OPENCLAW_MODEL=default
OPENCLAW_GATEWAY_TOKEN=

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_ENABLED=true
