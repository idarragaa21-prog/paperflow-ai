# ─────────────────────────────────────────────────────────────
# PaperFlow AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Environment: development | production
ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paperflow_ai

# ⚠️  REQUIRED IN PRODUCTION — generate with:
#    python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_with_secrets_token_hex_32

# Cookie domain (leave empty for localhost dev, set to your domain in production)
# Example: COOKIE_DOMAIN=paperflow.ai
COOKIE_DOMAIN=

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BASE_PATH=~/PaperFlowAIData
STORAGE_BACKEND=filesystem

# S3 (only if STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_ACCESS_KEY=paperflow
# S3_SECRET_KEY=paperflow123
# S3_BUCKET=paperflow-artifacts

# LLM stack
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENCLAW_BASE_URL=http://127.0.0.1:18789
QDRANT_URL=http://127.0.0.1:6333
GROBID_URL=http://127.0.0.1:8070
GROBID_ENABLED=true

# Auth — set REGISTRATION_OPEN=true to allow public sign-up
REGISTRATION_OPEN=false

# Optional: direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...

# Rate limiting
RATE_LIMIT_ENABLED=true
