# Backend env (copy to backend/.env)

# development | production
ENV=development

# IMPORTANT: change in production
SECRET_KEY=DEV_ONLY_CHANGE_ME

# Database (async SQLAlchemy)
# Local dev with docker-compose
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/paperflow_ai

# Redis (RQ jobs + rate limit)
REDIS_URL=redis://127.0.0.1:6379/0

# Storage base path (papers/books/notes/slides etc)
STORAGE_BASE_PATH=~/PaperFlowAIData
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=DEV_ONLY_ACCESS_KEY
S3_SECRET_KEY=DEV_ONLY_SECRET_KEY
S3_BUCKET=paperflow-artifacts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# OA resolvers
UNPAYWALL_EMAIL=you@example.com

# Meta-analysis extractor
META_MAX_CONCURRENT=3
# In production you can set OCR_ENABLED=true once tesseract/ocrmypdf are installed
OCR_ENABLED=false

# LLM routing
LLM_PROVIDER=openclaw
# single | ensemble
LLM_STRATEGY=single
PROJECT_DEFAULT_RUNTIME_MODE=local_only
PAPERFLOW_CHAT_MODEL=qwen2.5:7b
PAPERFLOW_EXTRACTION_MODEL=qwen2.5:7b
PAPERFLOW_WRITING_MODEL=llama3.1:8b
PAPERFLOW_EMBEDDING_MODEL=bge-m3
QDRANT_URL=http://127.0.0.1:6333
R_ENGINE_URL=http://127.0.0.1:8010
GROBID_URL=http://127.0.0.1:8070
GROBID_ENABLED=true
GROBID_TIMEOUT_SECONDS=45
CHAT_MIN_RETRIEVED_CHUNKS=2
CHAT_MIN_GROUNDED_SCORE=0.35
CHAT_ENABLE_INTERNAL_DEBUG=false
CHAT_DEFAULT_MODE=extractive_strict
OTEL_ENABLED=false
OTEL_SERVICE_NAME=paperflow-backend
METRICS_ENABLED=true

# OpenClaw Gateway
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TIMEOUT=120

# Default model (single strategy)
OPENCLAW_MODEL=default

# Optional vendor routing model names (used when LLM_STRATEGY=ensemble)
OPENCLAW_CLAUDE_MODEL=claude-sonnet-4.5
OPENCLAW_OPENAI_MODEL=gpt-4.1
OPENCLAW_GEMINI_MODEL=gemini-2.0-flash

# REQUIRED in production if gateway.auth.mode=token
OPENCLAW_GATEWAY_TOKEN=

# CORS (JSON array string)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Rate limiting
RATE_LIMIT_ENABLED=true

# === Direct provider keys (Phase 3, optional) ===
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Discovery
MODEL_DISCOVERY_ENABLED=false
BENCHMARK_THRESHOLD=85
