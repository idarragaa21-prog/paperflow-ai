# PaperFlow AI production environment template
#
# Supported production deploy:
#   frontend -> Vercel
#   backend  -> Render
#
# Split-origin deploy is the default for this repo.
# Same-origin only works if you run a real reverse proxy that preserves /api/*.

# Real backend origin. No trailing slash.
# Example:
#   VITE_API_BASE_URL=https://paperflow-api.onrender.com
VITE_API_BASE_URL=https://YOUR_RENDER_BACKEND_URL_HERE

# Production should use the real backend, not demo mode.
VITE_DEMO_MODE=false

# Same-origin is opt-in only if you truly proxy /api/*.
VITE_USE_SAME_ORIGIN_API=false
