# ── PaperFlow AI — Production environment template ─────────────────────────
# Copy to .env.production and fill in the values before deploying.
#
# Deployment strategy: Vercel (frontend) + Render (backend)
# The frontend and backend run on SEPARATE hosts. Same-origin proxy is NOT
# supported on Vercel. You MUST set VITE_API_BASE_URL.
#
# Steps:
#   1. Deploy backend to Render (render.yaml). Note the service URL.
#   2. Update render.yaml BACKEND_CORS_ORIGINS to include your Vercel domain.
#   3. Set VITE_API_BASE_URL below to your Render backend URL.
#   4. Deploy frontend to Vercel (connects to this file automatically).

# ── Required ────────────────────────────────────────────────────────────────

# Full URL of the backend service. No trailing slash.
# Example: https://paperflow-backend.onrender.com
VITE_API_BASE_URL=https://YOUR_RENDER_BACKEND_URL_HERE

# ── Fixed values (do not change) ────────────────────────────────────────────

# Disables demo/mock mode — use real backend.
VITE_DEMO_MODE=false
