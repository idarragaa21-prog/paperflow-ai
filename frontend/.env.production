# Production build defaults for the supported split deploy:
#   frontend -> Vercel
#   backend  -> Render
VITE_DEMO_MODE=false

# Production must set the real backend origin in the hosting dashboard.
# Example:
#   VITE_API_BASE_URL=https://paperflow-api.onrender.com
VITE_API_BASE_URL=__REQUIRE_EXPLICIT_API_BASE_URL__

# Same-origin is opt-in only if you deploy a real reverse proxy that keeps /api/*
# on the backend and never rewrites it to index.html.
VITE_USE_SAME_ORIGIN_API=false
