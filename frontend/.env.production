# ── Production build (real backend) ───────────────────────
# This file is used by 'npm run build' for real deployments.
# VITE_DEMO_MODE must be false — demo mode is for GitHub Pages only.
VITE_DEMO_MODE=false

# Backend API URL.
# REQUIRED when deploying frontend and backend on separate hosts (e.g. Vercel + Render).
# Set this to the full backend URL, e.g.:
#   VITE_API_BASE_URL=https://paperflow-backend.onrender.com
# Leave empty ONLY if the frontend is served behind a reverse proxy that routes
# /api/* to the backend on the same origin (same-origin strategy).
VITE_API_BASE_URL=
