# Frontend env (production)
# Use a fully qualified backend origin in production. Do not leave this blank.
# Vercel env vars should override this placeholder at build time.
VITE_API_BASE_URL=__SET_PRODUCTION_API_BASE_URL__

# Only enable this if your production host proxies /api/* to the backend.
# Vercel is configured to avoid rewriting /api/* to index.html by default.
VITE_USE_SAME_ORIGIN_API=false
VITE_ENABLE_LEGACY_MODULES=false
