# ── Production environment ────────────────────────────────
# VITE_DEMO_MODE=true  → mock data, no backend needed (GitHub Pages demo)
# VITE_DEMO_MODE=false → real backend required
VITE_DEMO_MODE=true

# Backend API URL — REQUIRED when VITE_DEMO_MODE=false.
# Leave empty to use same-origin (reverse proxy on same domain).
# Set explicitly if backend is on a different host:
#   VITE_API_BASE_URL=https://api.paperflow.example.com
VITE_API_BASE_URL=
