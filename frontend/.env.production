# ── Production build (real backend) ───────────────────────
# This file is used by 'npm run build' for real deployments.
# VITE_DEMO_MODE must be false — demo mode is for GitHub Pages only.
VITE_DEMO_MODE=false

# Backend API URL.
# Empty = same-origin (assumes reverse proxy routing /api/* to backend).
# Set explicitly if backend is on a different host:
#   VITE_API_BASE_URL=https://api.paperflow.example.com
VITE_API_BASE_URL=
